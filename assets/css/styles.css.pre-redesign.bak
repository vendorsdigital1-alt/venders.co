@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--ink:#17201e;--muted:#5d6965;--paper:#f7f7f2;--white:#fff;--line:#dfe4df;--lime:#c8f169;--blue:#4267ff;--dark:#17201e;--radius:20px;--shadow:0 20px 60px #17201e12;--font:'DM Sans',Arial,sans-serif;--display:'Manrope',Arial,sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.65 var(--font)}a{color:inherit;text-decoration:none}a:hover{color:var(--blue)}button,input,select,textarea{font:inherit}img{max-width:100%;height:auto}h1,h2,h3,h4{font-family:var(--display);line-height:1.08;letter-spacing:-.045em;margin:0 0 18px}h1{font-size:clamp(3rem,8vw,6.4rem);max-width:900px}h2{font-size:clamp(2.2rem,5vw,4rem)}h3{font-size:1.35rem;letter-spacing:-.03em}p{margin:0 0 18px;color:var(--muted)}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}.section{padding:100px 0}.section-sm{padding:70px 0}.eyebrow{font-size:.76rem;text-transform:uppercase;letter-spacing:.15em;font-weight:700;color:#4c6858;margin-bottom:18px}.lead{font-size:clamp(1.1rem,2vw,1.3rem);max-width:670px}.tag{display:inline-flex;padding:7px 12px;background:#edf3df;border-radius:100px;font-size:.77rem;font-weight:700;color:#29412d}.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:50px;padding:0 21px;border:1px solid var(--ink);border-radius:100px;background:var(--ink);color:#fff;font-weight:700;transition:transform .2s,background .2s}.btn:hover{color:#fff;background:#34413c;transform:translateY(-2px)}.btn.secondary{background:transparent;color:var(--ink)}.btn.secondary:hover{background:#fff}.btn.lime{background:var(--lime);border-color:var(--lime);color:var(--ink)}.btn.small{min-height:42px;padding:0 16px;font-size:.9rem}.button-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.site-header{height:78px;display:flex;align-items:center;position:sticky;top:0;z-index:20;background:#f7f7f2ed;backdrop-filter:blur(14px);border-bottom:1px solid #e8ebe6}.nav-inner{display:flex;align-items:center;justify-content:space-between;gap:22px}.logo{font:800 1.3rem var(--display);letter-spacing:-.08em}.logo span{color:var(--blue)}.nav-links{display:flex;align-items:center;gap:26px;font-size:.92rem;font-weight:600}.nav-links a:not(.btn):hover{color:var(--blue)}.menu-toggle{display:none;border:1px solid var(--line);background:transparent;border-radius:50%;width:44px;height:44px;font-size:1.2rem}.hero{padding:90px 0 75px;overflow:hidden}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:50px}.hero h1 span{color:var(--blue)}.hero-art{min-height:450px;background:#e8eee6;border-radius:28px;position:relative;overflow:hidden;padding:30px;display:flex;align-items:flex-end}.hero-art:before{content:'';position:absolute;width:390px;height:390px;border-radius:50%;background:var(--lime);top:20px;right:-75px}.hero-art:after{content:'V';position:absolute;font:800 20rem/.8 var(--display);color:#fff;top:35px;left:35px;transform:rotate(-12deg)}.hero-card{position:relative;z-index:1;background:#fff;padding:22px;border-radius:18px;width:min(290px,90%);box-shadow:var(--shadow)}.hero-card strong{display:block;font:700 1.1rem var(--display);margin:7px 0}.hero-card p{font-size:.88rem;margin:0}.hero-orbit{position:absolute;right:25px;bottom:30px;background:var(--dark);color:#fff;padding:15px 20px;border-radius:40px;z-index:2;font-size:.83rem}.grid{display:grid;gap:18px}.grid-2{grid-template-columns:repeat(2,1fr)}.grid-3{grid-template-columns:repeat(3,1fr)}.grid-4{grid-template-columns:repeat(4,1fr)}.card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:26px;box-shadow:0 8px 24px #17201e05}.card p:last-child{margin-bottom:0}.icon{width:46px;height:46px;border-radius:14px;background:#edf3df;display:grid;place-items:center;font-size:1.3rem;margin-bottom:23px}.card-link{display:inline-flex;margin-top:14px;font-weight:700;color:var(--ink)}.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:38px}.section-head>div{max-width:670px}.soft{background:#edf0e9}.dark-section{background:var(--dark);color:#fff}.dark-section p{color:#bbc4be}.dark-section .eyebrow{color:var(--lime)}.showcase-visual{height:185px;border-radius:16px;margin:-8px -8px 22px;position:relative;overflow:hidden;background:linear-gradient(135deg,#e5c6b4,#704f50)}.showcase-visual:after{content:'';position:absolute;background:#fff9;border-radius:18px;width:55%;height:62%;right:10%;bottom:10%;box-shadow:-55px -28px 0 -8px #fff8}.showcase-visual.food{background:linear-gradient(145deg,#eaa74e,#772f1a)}.showcase-visual.trade{background:linear-gradient(145deg,#bac9bd,#334943)}.showcase-visual.retail{background:linear-gradient(145deg,#bca0e9,#47356b)}.showcase-visual.clean{background:linear-gradient(145deg,#a5d9df,#2c7191)}.showcase-visual.edu{background:linear-gradient(145deg,#f0d27e,#56694d)}.showcase-visual.photo{background:linear-gradient(145deg,#b6bdc5,#333844)}.showcase-visual.auto{background:linear-gradient(145deg,#c1c4c3,#222)}.showcase-visual.stay{background:linear-gradient(145deg,#bdd8bd,#38644e)}.filter-row{display:flex;gap:8px;overflow:auto;padding-bottom:12px;margin-bottom:25px}.filter-btn{white-space:nowrap;background:#fff;border:1px solid var(--line);padding:9px 14px;border-radius:30px;cursor:pointer;font-weight:600;color:var(--ink)}.filter-btn[aria-pressed=true]{background:var(--ink);color:white;border-color:var(--ink)}.industry-card[hidden]{display:none}.price{font:800 2rem var(--display);letter-spacing:-.06em;color:var(--ink)}.price small{font:500 .9rem var(--font);letter-spacing:0;color:var(--muted)}ul.check-list{list-style:none;margin:20px 0;padding:0}ul.check-list li{padding:8px 0;border-bottom:1px solid var(--line);color:var(--muted)}ul.check-list li:before{content:'✓';color:#50754f;font-weight:800;margin-right:10px}.steps{counter-reset:step}.step{position:relative;padding:25px 20px 22px 62px;border-top:1px solid #ffffff35}.step:before{counter-increment:step;content:'0' counter(step);position:absolute;left:12px;top:22px;color:var(--lime);font-weight:700}.faq-item{border-bottom:1px solid var(--line)}.faq-item summary{padding:20px 36px 20px 0;cursor:pointer;font-weight:700;list-style:none;position:relative}.faq-item summary:after{content:'+';position:absolute;right:5px;font-size:1.4rem}.faq-item[open] summary:after{content:'−'}.faq-item p{max-width:760px;padding-bottom:12px}.page-hero{padding:78px 0 58px}.page-hero h1{font-size:clamp(2.8rem,7vw,5.2rem)}.split{display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:start}.price-card{position:relative}.price-card.featured{border:2px solid var(--ink)}.price-card .tag{margin-bottom:18px}.quote-note{background:#eef3e8;border-left:4px solid var(--lime);padding:20px 22px;border-radius:0 14px 14px 0;color:#45524b}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px}.field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}.field label{font-weight:700;font-size:.9rem}.field input,.field textarea,.field select{width:100%;border:1px solid #cbd3cd;background:white;border-radius:11px;padding:13px 14px;color:var(--ink)}.field textarea{min-height:130px;resize:vertical}.field input:focus,.field textarea:focus,.field select:focus{outline:3px solid #4267ff36;border-color:var(--blue)}.form-status{padding:14px;background:#edf3df;border-radius:12px;margin-top:15px;display:none}.form-status:not(:empty){display:block}.footer{background:#17201e;color:#fff;padding:60px 0 25px}.footer p{color:#b6c0ba}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:35px}.footer h3{font-size:.95rem;letter-spacing:0}.footer-links{display:grid;gap:9px;color:#bec7c2;font-size:.9rem}.footer-bottom{border-top:1px solid #ffffff24;margin-top:45px;padding-top:20px;display:flex;justify-content:space-between;gap:20px;color:#bbc4be;font-size:.85rem}.notice{font-size:.9rem;padding:14px 16px;border:1px solid var(--line);border-radius:12px;color:var(--muted)}.reveal{animation:rise .65s both}@keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}:focus-visible{outline:3px solid var(--cyan);outline-offset:4px}.skip-link{position:absolute;top:-50px;left:10px;background:#fff;padding:10px;z-index:100}.skip-link:focus{top:10px}
@media(max-width:900px){.nav-links{gap:15px}.grid-4{grid-template-columns:repeat(2,1fr)}.hero-grid{gap:28px}.hero-art{min-height:380px}.footer-grid{grid-template-columns:1fr 1fr}.section{padding:78px 0}}
@media(max-width:680px){.wrap{width:min(100% - 32px,1160px)}.site-header{height:68px}.menu-toggle{display:grid;place-items:center}.nav-links{display:none;position:absolute;top:68px;left:0;right:0;padding:18px 22px 25px;background:var(--paper);border-bottom:1px solid var(--line);align-items:stretch;flex-direction:column;gap:13px}.nav-links.open{display:flex}.nav-links a{padding:8px 2px}.nav-links .btn{align-self:flex-start}.hero{padding:55px 0 50px}.hero-grid,.split{grid-template-columns:1fr}.hero-art{min-height:330px}.hero-art:after{font-size:15rem}.section{padding:65px 0}.section-sm{padding:50px 0}.section-head{display:block}.section-head .btn{margin-top:12px}.grid-3,.grid-2,.grid-4{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}.footer-bottom{flex-direction:column}.page-hero{padding:55px 0 35px}h1{font-size:clamp(2.7rem,14vw,4.5rem)}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}

/* VENDERS.CO studio art direction — layered onto the existing component system. */
:root{--ink:#f4f7ff;--muted:#aab5cc;--paper:#0b1020;--white:#121a2d;--line:#26324b;--lime:#49e8ff;--blue:#637dff;--dark:#080d19;--radius:22px;--shadow:0 24px 70px #0206118c;--cyan:#49e8ff;--violet:#9474ff;--coral:#ff876c;--surface:#111a2d;--surface-raised:#17233a;--space-1:.5rem;--space-2:1rem;--space-3:1.5rem;--space-4:2rem;--space-5:3rem;--space-6:4rem;--font:'DM Sans',Arial,sans-serif;--display:'Manrope',Arial,sans-serif}
html{background:var(--paper)}body{background:var(--paper);color:var(--ink);overflow-x:hidden}p{color:var(--muted)}a:hover{color:var(--cyan)}h1,h2,h3{color:var(--ink)}.wrap{width:min(1200px,calc(100% - 48px))}.section{position:relative;padding:clamp(76px,9vw,120px) 0}.section-sm{padding:clamp(52px,7vw,82px) 0}.eyebrow{color:var(--cyan);letter-spacing:.19em;font-size:.7rem}.lead{color:#d1d9eb}.tag{background:#152940;color:#a8f4ff;border:1px solid #294b64}.notice{background:#111a2d;border-color:#34425e;color:#bdc9dd}.card{background:linear-gradient(145deg,#151e32,#101727 70%);border-color:#293650;box-shadow:0 18px 44px #03071355;position:relative;overflow:hidden}.card:after{content:'';position:absolute;inset:0 auto auto 0;width:72px;height:2px;background:linear-gradient(90deg,var(--cyan),transparent);opacity:.8}.card:hover{transform:translateY(-5px);border-color:#526b9b;box-shadow:0 24px 54px #02061199}.card,.btn,.filter-btn,.nav-links a{transition:transform .24s ease,border-color .24s ease,background .24s ease,color .24s ease,box-shadow .24s ease}.icon{background:linear-gradient(140deg,#163752,#252449);border:1px solid #31607c;color:#8aeeff;box-shadow:inset 0 0 22px #4196d61c;font-size:0;position:relative}.icon:before,.icon:after{content:'';position:absolute;border:1px solid currentColor;border-radius:8px;transform:rotate(-12deg)}.icon:before{width:18px;height:22px;left:12px;top:10px}.icon:after{width:12px;height:16px;left:20px;top:14px;background:#182640}
.site-header{height:76px;background:#080d19eF;border-bottom:1px solid #27334d;box-shadow:0 7px 25px #03071325}.logo{color:#f4f7ff;letter-spacing:-.07em}.logo span{color:var(--cyan)}.nav-links{color:#d3dbee}.nav-links a:not(.btn):hover{color:var(--cyan)}.menu-toggle{color:#fff;border-color:#34415c;background:#111a2d}.skip-link{color:#111;background:#fff}.btn{background:linear-gradient(110deg,#546eff,#3d91ff 56%,#35c8ea);border-color:transparent;color:#07101e;box-shadow:0 8px 24px #527dff36}.btn:hover{background:linear-gradient(110deg,#7186ff,#53aaff 56%,#56e2ef);color:#07101e;box-shadow:0 10px 30px #55a5ff55}.btn.secondary{background:transparent;border-color:#66799f;color:#e7eeff;box-shadow:none}.btn.secondary:hover{background:#18243b;border-color:var(--cyan);color:#fff}.btn.lime{background:var(--cyan);border-color:var(--cyan);color:#07101e;box-shadow:0 8px 28px #49e8ff30}.btn.small{color:#06111e}.button-row{gap:14px}
.hero{position:relative;isolation:isolate;overflow:hidden;padding:clamp(65px,8vw,105px) 0 88px;background:radial-gradient(ellipse at 80% 42%,#26386a 0,transparent 37%),radial-gradient(ellipse at 5% 110%,#122948 0,transparent 42%),linear-gradient(125deg,#090e1b 10%,#0b1224 68%,#101631)}.hero:before,.page-hero:before{content:'';position:absolute;z-index:-1;inset:0;background-image:linear-gradient(#a9c3ff0a 1px,transparent 1px),linear-gradient(90deg,#a9c3ff0a 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(90deg,transparent,#000 42%,#000 94%,transparent)}.hero:after{content:'';position:absolute;z-index:-1;right:-14vw;top:-38vw;width:70vw;height:70vw;max-width:880px;max-height:880px;border:1px solid #86aaff22;border-radius:50%;box-shadow:0 0 0 70px #86aaff08,0 0 0 150px #86aaff05;pointer-events:none}.hero-grid{grid-template-columns:1fr 1fr;gap:55px;position:relative;z-index:1}.hero h1{max-width:680px;font-size:clamp(3.35rem,7.2vw,6.25rem);letter-spacing:-.075em}.hero h1 span{background:linear-gradient(100deg,#78a3ff,#48e8ff 72%);-webkit-background-clip:text;background-clip:text;color:transparent}.hero .lead{max-width:600px}.hero .eyebrow{color:#8deeff}.hero .notice{display:inline-block;width:fit-content;margin-top:22px!important;color:#bac9df;background:#141f35d9}.hero-art{min-height:490px;border:1px solid #91a9ff42;border-radius:30px;background:radial-gradient(circle at 72% 20%,#61e7ff52 0,transparent 24%),radial-gradient(circle at 25% 78%,#795eff46 0,transparent 34%),linear-gradient(145deg,#182445,#10192c 70%);box-shadow:0 35px 90px #02061199,inset 0 1px #ffffff18;isolation:isolate}.hero-art:before{content:'';position:absolute;z-index:0;inset:8% 9% 18%;border:1px solid #a5c2ff40;border-radius:18px;transform:rotate(-5deg);background:linear-gradient(130deg,#6da7ff16,#131f35 52%,#51e2ff12);box-shadow:0 28px 52px #02061177}.hero-art:after{content:'';position:absolute;z-index:0;top:16%;left:16%;width:110px;height:110px;border-radius:50%;background:radial-gradient(circle at 35% 32%,#d7fbff,#55dfff 28%,#3974ff 63%,#804dff);box-shadow:0 0 50px #41caff86,0 0 100px #576dff3a;transform:none;font-size:0}.hero-card{z-index:2;width:min(330px,76%);margin:0 0 27px 28px;border:1px solid #ffffff25;background:#0b1325ed;color:#fff;backdrop-filter:blur(14px);box-shadow:0 18px 60px #02061199}.hero-card .tag{background:#142e44}.hero-card strong{font:700 1.35rem/1.2 var(--display);letter-spacing:-.04em}.hero-card p{color:#bbc8dc}.hero-orbit{z-index:2;right:25px;bottom:36px;color:#06111e;background:var(--cyan);font-weight:700;box-shadow:0 0 32px #49e8ff5c}.reveal{animation:rise .65s both}
.section-head{margin-bottom:44px}.section-head>div{max-width:750px}.section-head h2,.section h2{letter-spacing:-.065em}.section:not(.soft):not(.dark-section){background:linear-gradient(180deg,#0b1020,#0d1425 100%)}.section.soft{background:linear-gradient(130deg,#121d33,#10182a 60%,#171a35);border-top:1px solid #273550;border-bottom:1px solid #273550}.section.dark-section{background:radial-gradient(ellipse at 90% 12%,#22285d,#0a0f1d 60%);border-block:1px solid #26324b}.dark-section p{color:#b1bfd5}.dark-section .eyebrow{color:var(--cyan)}.steps{gap:10px}.step{border-color:#39435c}.step:before{color:var(--cyan)}.card h3,.step h3{color:#f5f8ff}.card-link{color:#9defff}.card-link:hover{color:#fff}.check-list li{border-color:#2c3851;color:#b5c2d9}.check-list li:before{color:#55e0e8}.faq-item{border-color:#34405a}.faq-item summary{color:#edf2ff}.faq-item p{color:#b4c1d8}.page-hero{position:relative;isolation:isolate;overflow:hidden;background:radial-gradient(ellipse at 88% 20%,#29376a,transparent 37%),linear-gradient(125deg,#0a0f1e,#11182d);padding:clamp(60px,8vw,96px) 0 68px;border-bottom:1px solid #2a3754}.page-hero .wrap{position:relative;z-index:1}.page-hero h1{font-size:clamp(3.1rem,7vw,5.5rem)}.page-hero .lead{color:#c0cbe0}.page-hero:after{content:'';position:absolute;right:7%;top:15%;width:150px;height:150px;border-radius:50%;border:1px solid #72dbff68;box-shadow:0 0 0 24px #7c8bff0a,0 0 55px #4daeff38}.price{color:#9cf1ff}.price-card.featured{border-color:#5f8dff;box-shadow:0 0 0 1px #5f8dff55,0 24px 65px #0307138c}.price-card.featured:before{content:'';position:absolute;inset:0 0 auto;height:3px;background:linear-gradient(90deg,var(--blue),var(--cyan),var(--violet))}.quote-note{background:linear-gradient(120deg,#17243a,#111a2d);border-color:var(--cyan);color:#c2cde0}.field label{color:#e4ebfa}.field input,.field textarea,.field select{background:#0c1425;border-color:#34415c;color:#f0f4ff}.field input::placeholder,.field textarea::placeholder{color:#8997b1}.field input:focus,.field textarea:focus,.field select:focus{outline-color:#49e8ff4d;border-color:var(--cyan)}.form-status{background:#142c3d;color:#d8faff;border:1px solid #28768d}.footer{background:#070b15;border-top:1px solid #27334d}.footer p{color:#aab6cc}.footer-links{color:#bac6da}.footer-bottom{border-color:#26324b;color:#a4b1c9}.footer h3{color:#f1f5ff}.footer .logo span{color:var(--cyan)}.filter-row{scrollbar-color:#42577c #111a2d}.filter-btn{background:#121c30;color:#cdd8ec;border-color:#35425d}.filter-btn:hover{border-color:#6ea8ff;color:#fff;transform:translateY(-1px)}.filter-btn[aria-pressed=true]{background:linear-gradient(110deg,#506cff,#269cca);border-color:transparent;color:#07101e}.showcase-visual{height:210px;border:1px solid #526280;background:radial-gradient(ellipse at 70% 25%,#55cfff 0,transparent 24%),linear-gradient(135deg,#273a63,#141d35 70%);box-shadow:0 16px 32px #03071370;isolation:isolate}.showcase-visual:before{content:'';position:absolute;z-index:1;top:13px;left:14px;width:calc(100% - 28px);height:16px;border-radius:5px 5px 0 0;background:linear-gradient(90deg,#29344b 0 40px,transparent 40px),radial-gradient(circle at 8px 8px,#ff927d 2px,transparent 3px),radial-gradient(circle at 17px 8px,#ffd477 2px,transparent 3px),radial-gradient(circle at 26px 8px,#72e6c0 2px,transparent 3px),#1b2943;border:1px solid #7283a34d}.showcase-visual:after{z-index:0;right:10%;bottom:11%;width:67%;height:58%;border-radius:8px;background:linear-gradient(180deg,#f2f5ff 0 16%,#e9edfa 17% 100%);box-shadow:-70px -30px 0 -8px #ffffffc9,0 17px 35px #0307136e}.showcase-visual.food{background:radial-gradient(circle at 69% 55%,#e7a346 0 13%,#802f23 14% 24%,transparent 25%),linear-gradient(130deg,#512822,#d95f38 55%,#2a1e25)}.showcase-visual.trade{background:linear-gradient(140deg,#2c564f,#182935 55%,#5b8970)}.showcase-visual.retail{background:linear-gradient(140deg,#5b3e91,#b067c8 58%,#201d3f)}.showcase-visual.clean{background:linear-gradient(140deg,#147f9d,#a0eef5 70%,#28396a)}.showcase-visual.edu{background:linear-gradient(140deg,#826b35,#d2af58 55%,#243b3b)}.showcase-visual.photo{background:linear-gradient(140deg,#27304e,#7b8297 50%,#252b3d)}.showcase-visual.auto{background:linear-gradient(140deg,#343844,#92959f 55%,#141923)}.showcase-visual.stay{background:linear-gradient(140deg,#1c604c,#9dc59a 55%,#243b38)}.industry-card .showcase-visual{margin:-8px -8px 22px}.industry-card .btn.small{margin-top:10px}.industry-card .tag{font-size:.68rem;line-height:1.3}.hero .button-row{margin-top:26px}.section:has(.showcase-visual){background:radial-gradient(ellipse at 12% 30%,#1d2d52,#0a1020 68%);overflow:hidden}.section:has(.showcase-visual):before{content:'V / C';position:absolute;right:4vw;top:4%;font:800 clamp(7rem,18vw,18rem)/.8 var(--display);letter-spacing:-.1em;color:#fff;opacity:.025;pointer-events:none}.section:has(.showcase-visual) .card{background:#121c30;border-color:#34445f}.section:has(.showcase-visual) .card:hover{border-color:#5e81cf}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr 1fr}.hero-art{min-height:410px}.showcase-visual{height:185px}}
@media(max-width:680px){.wrap{width:min(100% - 32px,1200px)}.site-header{background:#080d19f5}.nav-links{background:#0b1121;border-color:#2b3650;box-shadow:0 18px 30px #030713aa}.nav-links a{color:#e4ebfb}.nav-links .btn{color:#07101e}.hero{padding:54px 0 58px}.hero-grid{grid-template-columns:1fr;gap:32px}.hero h1{font-size:clamp(3.05rem,14vw,4.7rem)}.hero-art{min-height:330px;border-radius:23px}.hero-art:before{inset:8% 7% 19%}.hero-art:after{width:75px;height:75px;top:15%;left:15%}.hero-card{padding:18px;margin:0 0 20px 18px}.hero-orbit{right:14px;bottom:23px;font-size:.75rem}.section{padding:68px 0}.section:has(.showcase-visual){padding-top:72px;padding-bottom:72px}.section-head{margin-bottom:30px}.showcase-visual{height:200px}.page-hero{padding:54px 0 48px}.page-hero:after{width:90px;height:90px;right:4%;top:10%}.card{padding:23px}.industry-card .showcase-visual{margin:-6px -6px 20px}.footer{padding:48px 0 24px}.btn{min-height:48px}}
@media(hover:none){.card:hover,.btn:hover{transform:none}}
@media(max-width:800px) and (min-width:681px){.menu-toggle{display:grid;place-items:center}.nav-links{display:none;position:absolute;top:76px;left:0;right:0;padding:18px 24px 25px;background:#0b1121;border-bottom:1px solid #2b3650;align-items:stretch;flex-direction:column;gap:13px}.nav-links.open{display:flex}.nav-links a{padding:8px 2px}.nav-links .btn{align-self:flex-start}.hero-grid{grid-template-columns:1fr;gap:34px}.hero-art{min-height:380px}.split{grid-template-columns:1fr}.grid-3{grid-template-columns:repeat(2,minmax(0,1fr))}.section:has(.showcase-visual) .grid-3{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* Portfolio browser previews use tiny, industry-specific page compositions. */
.showcase-visual{height:236px;border-radius:14px;background-color:#172442;background-image:radial-gradient(circle at 76% 70%,#5ad8ff66,transparent 29%),linear-gradient(145deg,#243a68,#121c34 70%)}
.showcase-visual:before{top:10px;left:10px;width:calc(100% - 20px);height:18px;background:radial-gradient(circle at 10px 9px,#ff917c 2px,transparent 3px),radial-gradient(circle at 20px 9px,#ffd276 2px,transparent 3px),radial-gradient(circle at 30px 9px,#75e5bc 2px,transparent 3px),linear-gradient(90deg,#24334f,#18243b);border-color:#8295bd66}
.showcase-visual:after{right:10px;bottom:10px;width:calc(100% - 20px);height:calc(100% - 38px);border:0;border-radius:0 0 8px 8px;background-color:#f3f1ed;background-image:linear-gradient(#7b6260,#7b6260),linear-gradient(#ad9992,#ad9992),linear-gradient(#d0c0b9,#d0c0b9),radial-gradient(ellipse at 50% 40%,#f0c9b7 0 16%,transparent 17%),linear-gradient(140deg,#9b6e60,#d8ac93);background-size:22% 5px,18% 4px,21% 4px,32% 74%,32% 74%;background-position:8% 29%,8% 39%,8% 48%,90% 80%,90% 80%;background-repeat:no-repeat;box-shadow:0 13px 24px #03071377}
.showcase-visual.food{background-image:radial-gradient(circle at 74% 46%,#ffcc7c4d,transparent 30%),linear-gradient(130deg,#552820,#dc6941 55%,#261c24)}
.showcase-visual.food:after{background-color:#f7efe2;background-image:linear-gradient(#963a2d,#963a2d),linear-gradient(#634338,#634338),linear-gradient(#a88262,#a88262),radial-gradient(circle at 50% 50%,#d98743 0 31%,#f1db9c 32% 39%,#faf0dc 40% 56%,transparent 57%),radial-gradient(circle at 39% 42%,#71864d 0 4%,transparent 5%),radial-gradient(circle at 59% 58%,#9e442e 0 5%,transparent 6%);background-size:24% 6px,20% 4px,18% 4px,43% 82%,43% 82%,43% 82%;background-position:8% 29%,8% 39%,8% 48%,91% 80%,91% 80%,91% 80%;background-repeat:no-repeat}
.showcase-visual.trade{background-image:linear-gradient(145deg,#335a4d,#152d34 55%,#91a58b)}
.showcase-visual.trade:after{background-color:#e9eee6;background-image:linear-gradient(#30483f,#30483f),linear-gradient(#698273,#698273),linear-gradient(#71867a,#71867a),linear-gradient(145deg,transparent 0 39%,#334c42 40% 49%,transparent 50%),linear-gradient(#dfd8c7,#dfd8c7);background-size:24% 6px,20% 4px,18% 4px,43% 82%,43% 82%;background-position:8% 29%,8% 39%,8% 48%,91% 80%,91% 80%;background-repeat:no-repeat}
.showcase-visual.retail{background-image:linear-gradient(135deg,#412e73,#c266a4 56%,#171d3a)}.showcase-visual.clean{background-image:linear-gradient(135deg,#096d8b,#6ed4d8 58%,#202b5c)}.showcase-visual.edu{background-image:linear-gradient(135deg,#65512b,#d4b567 58%,#253d3c)}.showcase-visual.photo{background-image:linear-gradient(135deg,#212a45,#8290a4 58%,#252737)}.showcase-visual.auto{background-image:linear-gradient(135deg,#1f2734,#77818e 55%,#151922)}.showcase-visual.stay{background-image:linear-gradient(135deg,#20594d,#9bbd91 56%,#1c3940)}

.showcase-visual.showcase-preview{height:auto;min-height:0;padding:7px;border-radius:14px;background:#101827;box-shadow:0 12px 28px #10182726}
.showcase-visual.showcase-preview:before,.showcase-visual.showcase-preview:after{display:none}
.preview-card{transition:transform .24s ease,box-shadow .24s ease}
.preview-card:hover,.preview-card:focus-within{transform:translateY(-3px);box-shadow:0 16px 34px #17201e16}
.preview-browser{overflow:hidden;border-radius:9px;background:#fff;color:#1d2824}
.preview-chrome{height:22px;display:flex;align-items:center;gap:5px;padding:0 9px;background:#f0f1f1;border-bottom:1px solid #e2e5e3}
.preview-chrome i{width:6px;height:6px;border-radius:50%;background:#dc887e}
.preview-chrome i:nth-child(2){background:#e4bc70}.preview-chrome i:nth-child(3){background:#76ae91}
.preview-chrome span{margin-left:7px;color:#738078;font-size:8px;letter-spacing:.04em}
.preview-site{--preview-accent:#a36f63;--preview-paper:#faf4ef;--preview-ink:#382b29;background:var(--preview-paper);color:var(--preview-ink)}
.preview-site-nav{height:31px;display:flex;align-items:center;justify-content:space-between;gap:5px;padding:0 10px;border-bottom:1px solid #453a3218}
.preview-site-nav strong{font:700 10px var(--display);white-space:nowrap}
.preview-site-nav span{font-size:8px;color:#655d57;white-space:nowrap}
.preview-site-nav>b{padding:4px 7px;background:var(--preview-ink);color:#fff;font-size:7px;letter-spacing:.04em;white-space:nowrap}
.preview-hero{height:136px;display:grid;grid-template-columns:1fr .83fr;align-items:stretch;gap:9px;padding:12px 11px 9px}
.preview-copy{display:flex;align-items:flex-start;justify-content:center;flex-direction:column;min-width:0}
.preview-copy>small{margin-bottom:6px;color:var(--preview-accent);font-size:7px;font-weight:800;letter-spacing:.13em}
.preview-copy>strong{font:700 clamp(16px,2vw,23px)/1.02 var(--display);letter-spacing:-.055em}
.preview-action{display:inline-flex;align-items:center;gap:7px;margin-top:9px;padding:5px 7px;background:var(--preview-ink);color:#fff;font-size:7px;font-weight:700;letter-spacing:.04em}
.preview-action i{font-style:normal;color:var(--lime)}
.preview-photo{position:relative;overflow:hidden;min-width:0;margin:0;border-radius:3px;background:#d9d1c6}
.preview-photo img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .28s ease}
.preview-photo.image-unavailable{display:grid;place-items:center;padding:10px;background:#eee7de;color:#6d625b;text-align:center;font-size:9px}
.preview-photo .image-fallback[hidden]{display:none}
.preview-glow .preview-site{--preview-accent:#a36656;--preview-paper:#f8f1eb;--preview-ink:#3a2b2a}
.preview-glow .preview-site-nav strong{font-family:Georgia,serif;font-size:12px}
.preview-glow .preview-photo img{object-position:center 52%}
.preview-karoo .preview-site{--preview-accent:#c55231;--preview-paper:#faf3e6;--preview-ink:#30231d}
.preview-karoo .preview-site-nav{background:#fbf2e2}
.preview-karoo .preview-copy>strong{font-family:Georgia,serif}
.preview-karoo .preview-photo img{object-position:center 55%}
.preview-veld .preview-site{--preview-accent:#697b56;--preview-paper:#f0f1e9;--preview-ink:#1d2a25}
.preview-veld .preview-site-nav strong{font-size:9px;letter-spacing:.04em}
.preview-veld .preview-photo img{object-position:center 55%}
.preview-wizard .preview-site{--preview-accent:#72801d;--preview-paper:#eff1ed;--preview-ink:#171a1c}
.preview-wizard .preview-site-nav strong{font-size:8px;letter-spacing:.08em}
.preview-wizard .preview-photo img{object-position:center 48%}
.preview-form .preview-site{--preview-accent:#d04a36;--preview-paper:#f0eee8;--preview-ink:#17191a}
.preview-form .preview-site-nav strong{font:800 10px var(--display);letter-spacing:-.04em}
.preview-form .preview-copy>strong{font-family:Georgia,serif;font-style:italic;font-weight:500}
.preview-form .preview-photo img{object-position:center 42%}
.preview-haven .preview-site{--preview-accent:#ad7959;--preview-paper:#f3f0e9;--preview-ink:#252a27}
.preview-haven .preview-site-nav strong{font-family:Georgia,serif;font-size:10px}
.preview-haven .preview-copy>strong{font-family:Georgia,serif;font-weight:500}
.preview-haven .preview-photo img{object-position:center 52%}
.preview-kalahari .preview-site{--preview-accent:#b7814d;--preview-paper:#eee8dc;--preview-ink:#29261f}
.preview-kalahari .preview-site-nav{background:#29261f;color:#f4efe4}
.preview-kalahari .preview-site-nav span{color:#e0d5c4}
.preview-kalahari .preview-site-nav>b{background:#b7814d;color:#211f19}
.preview-kalahari .preview-copy>strong{font-family:Georgia,serif;font-weight:500}
.preview-kalahari .preview-photo img{object-position:center 55%}
.preview-details{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;padding:7px 10px 9px;border-top:1px solid #453a3218}
.preview-details span{display:grid;gap:2px;min-width:0}
.preview-details small{color:#77756e;font-size:6px;font-weight:800;letter-spacing:.1em}
.preview-details b{overflow:hidden;color:var(--preview-ink);font-size:8px;text-overflow:ellipsis;white-space:nowrap}
@media(max-width:680px){.preview-hero{height:126px;grid-template-columns:1fr .76fr}.preview-site-nav span{display:none}.preview-copy>strong{font-size:19px}}
@media(hover:hover){.preview-card:hover .preview-photo img{transform:scale(1.04)}}
@media(prefers-reduced-motion:reduce){.preview-card,.preview-photo img{transition:none}.preview-card:hover,.preview-card:focus-within{transform:none}}

.home-page main>section:not(.hero){display:none}
.home-page .hero:before,.home-page .hero:after{display:none}
.home-page .hero{display:flex;align-items:center;min-height:calc(100svh - 76px);padding:clamp(38px,7vh,82px) 0;background:radial-gradient(ellipse at 83% 50%,#17274b 0,transparent 38%),linear-gradient(125deg,#090e1b,#0b1224 72%,#101631)}
.home-page .hero-grid{grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);align-items:center;gap:clamp(26px,5vw,72px)}
.home-page .hero .reveal{max-width:510px}
.home-page .hero h1{font-size:clamp(3rem,6.5vw,5.5rem)}
.home-page .hero .lead{max-width:440px;color:#c5d0e5}
.home-page .home-options{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:center;justify-items:center;gap:clamp(8px,1.5vw,18px);max-width:640px;width:100%;justify-self:end}
.home-options-label{grid-column:1/-1;justify-self:start;margin:0 0 4px 3%;color:#91eafd;font-size:.7rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
.option-bubble{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;width:min(100%,136px);aspect-ratio:1;border:1px solid #7183a84d;border-radius:50%;padding:10px;background:radial-gradient(circle at 32% 25%,#263958,#111a2e 72%);box-shadow:0 14px 34px #03071370,inset 0 1px #ffffff18;color:#f1f6ff;text-align:center;font-size:clamp(.68rem,.9vw,.84rem);font-weight:700;line-height:1.25;transition:transform .22s ease,border-color .22s ease,box-shadow .22s ease}
.option-bubble:hover{transform:translateY(-4px) scale(1.025);border-color:#7fe9ff;box-shadow:0 18px 40px #0307139c,0 0 20px #49e8ff20;color:#fff}
.option-bubble:focus-visible{outline:3px solid #55e8ff;outline-offset:4px}
.option-pricing{width:min(100%,150px);background:radial-gradient(circle at 32% 25%,#397ac0,#203c76 72%);border-color:#80c9ff88}
.option-bubble span,.option-bubble small{font-size:.68em;font-weight:500;opacity:.8}
.option-bubble strong{font-size:1.15em}
.option-beauty{background:radial-gradient(circle at 30% 24%,#854b73,#30223c 72%)}
.option-food{background:radial-gradient(circle at 30% 24%,#ae653b,#43251f 72%)}
.option-home{background:radial-gradient(circle at 30% 24%,#526c52,#202e2b 72%)}
.option-auto{background:radial-gradient(circle at 30% 24%,#547392,#1d2938 72%)}
.option-retail{background:radial-gradient(circle at 30% 24%,#735d9b,#29233d 72%)}
.option-stay{background:radial-gradient(circle at 30% 24%,#748051,#293327 72%)}
.option-property{background:radial-gradient(circle at 30% 24%,#946d57,#332923 72%)}
@media(max-width:900px){.home-page .hero{min-height:auto;padding:68px 0}.home-page .hero-grid{grid-template-columns:1fr;gap:42px}.home-page .home-options{justify-self:start;max-width:680px}}
@media(max-width:600px){.home-page .hero{padding:54px 0 62px}.home-page .hero-grid{gap:30px}.home-page .hero h1{font-size:clamp(2.9rem,12vw,4.5rem)}.home-page .home-options{grid-template-columns:repeat(2,minmax(0,1fr));max-width:390px;gap:12px}.home-options-label{margin-left:0}.option-bubble{width:min(100%,136px);font-size:.82rem}.option-pricing{width:min(100%,145px)}}
@media(prefers-reduced-motion:reduce){.option-bubble{transition:none}.option-bubble:hover{transform:none}}
